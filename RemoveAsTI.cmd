@cls
@echo off
>nul chcp 437
setlocal enabledelayedexpansion

:::: check if we running under system Rights
whoami|>nul findstr /i /c:"nt authority\system" && (
	cd /d %~dp0
	set "_args="
	title Remove As TI
	call :RunAtSystemLevel %*
	exit
)

:::: Run as Admin with native shell, any path, params, loop guard, minimal i/o, by AveYo
>nul reg add hkcu\software\classes\.Admin\shell\runas\command /f /ve /d "cmd /x /d /r set \"f0=%%2\" &call \"%%2\" %%3" & set "_= %*"
>nul fltmc || if "%f0%" neq "%~f0" ( cd.>"%tmp%\runas.Admin" & start "%~n0" /high "%tmp%\runas.Admin" "%~f0" "%_:"=""%" &exit /b )

cd /d "%~dp0"
set "0=%~f0"
>nul powershell -nop -c $f=[IO.File]::ReadAllText($env:0)-split':bat2file\:.*';iex($f[1]); X(1)
set "filePath=%~dpfx0"
shift & set "args=%*"
call :RunAsTI cmd /c call "%filePath%" %args%
exit

:RunAtSystemLevel
:RunAtSystemLevel
:RunAtSystemLevel

echo.
shift
set "_var=%0"

if /i '!_var!' EQU '' (
	if not defined _args (
		
		rem no args from start
		echo Error ### Missing Args
		timeout 3
		exit
		
	) else (
		
		rem no more args
		echo Done for good this time.
		echo Close in 3 seconds
		>nul timeout 3
		exit
		
	)
)

set "_args=true"

if not exist !_var! (
	echo Selected Var :: '!_var!'
	echo Error ### File / Folder not exist
	timeout 3
	goto :RunAtSystemLevel
)

cd /d %systemdrive%
1>nul 2>nul pushd !_var! && (
	
	popd
	echo Remove Folder :: !_var!
	echo.
	rd /s /q !_var!
	if exist !_var! (
		>"%windir%\result" 2>&1 "%windir%\handle" -accepteula !_var!
		type "%windir%\result" |>nul find /i "No matching handles found."  && (echo.&&echo Error ### Fail to close Process Handle) || (
						
			rem https://superuser.com/a/486676
			rem How to unlock files using handle.exe and process name?
			
			echo.&echo Trying close Process Handle&echo Trying Remove Folder again&echo.
			for /f "tokens=3,6 skip=5 delims=: " %%i in ('type "%windir%\result"') do (
				>nul 2>&1 "%windir%\handle" -c %%j -y -p %%i
				>nul 2>&1 taskkill /t /f /PID %%i
			)
		)
		call :DestryFolder !_var!
	)

	echo Done ..
	goto :RunAtSystemLevel
	
) || (
	
	echo Remove File :: !_var!
	echo.
	del /q /f !_var!
	if exist !_var! (
		>"%windir%\result" 2>&1 "%windir%\handle" -accepteula !_var!
		type "%windir%\result" |>nul find /i "No matching handles found."  && (echo.&&echo Error ### Fail to close Process Handle) || (
		
			rem https://superuser.com/a/486676
			rem How to unlock files using handle.exe and process name?
			
			echo.&echo Trying close Process Handle&echo Trying Remove File again&echo.
			for /f "tokens=3,6 skip=5 delims=: " %%i in ('type "%windir%\result"') do (
				>nul 2>&1 "%windir%\handle" -c %%j -y -p %%i
				>nul 2>&1 taskkill /t /f /PID %%i
			)
			del /q /f !_var!
			if exist !_var! (
				set "rand=%random%.%random%"
				ren !_var! "!rand!"
				for %%I in (!_var!) do set "newFile=%%~dpI"
				if /i '!newFile:~-1!' EQU '\' (set "newFile=!newFile!!rand!") else (set "newFile=!newFile!\!rand!")
				if exist "!newFile!" move /y "!newFile!" "%windir%\temp"
			)
		)
	)
	
	echo Done ..
	goto :RunAtSystemLevel
	
)

goto :RunAtSystemLevel

:DestryFolder
>nul 2>&1 rd/s/q "%windir%\temp"
>nul 2>&1 md "%windir%\temp"
set targetFolder=%*
if exist %targetFolder% (
	rd /s /q %targetFolder%
	if exist %targetFolder% (
		for /f "tokens=*" %%g in ('dir /b/s /a-d %targetFolder%') do (
			move /y "%%g" "%windir%\temp"
			if exist "%%g" (
				set "rand=%random%.%random%"
				ren "%%g" "!rand!"
				for %%I in ("%%g") do set "newFile=%%~dpI"
				if /i '!newFile:~-1!' EQU '\' (set "newFile=!newFile!!rand!") else (set "newFile=!newFile!\!rand!")
				if exist "!newFile!" move /y "!newFile!" "%windir%\temp"
			)
		)
		rd /s /q %targetFolder%
	)
)
goto :eof

